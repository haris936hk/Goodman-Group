# Persistent private paths must be absolute and outside the checkout/release.
DATABASE_URL=file:/ABSOLUTE_PRIVATE_PATH/shared/data/blog.sqlite
UPLOAD_DIR=/ABSOLUTE_PRIVATE_PATH/shared/uploads
# Generate a high-entropy secret and keep it stable in protected host settings.
PAYLOAD_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_SECRET_CHARACTERS
PAYLOAD_CONFIG_PATH=/ABSOLUTE_RELEASE_PATH/payload.config.ts
# Existing enquiry settings remain separate; see README.
