# Use the Supabase PostgreSQL connection string, including SSL settings.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
# Vercel Blob store token; media is uploaded server-side.
BLOB_READ_WRITE_TOKEN=REPLACE_WITH_VERCEL_BLOB_READ_WRITE_TOKEN
# Generate a high-entropy secret and keep it stable in protected host settings.
PAYLOAD_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_SECRET_CHARACTERS
# Existing enquiry settings remain separate; see README.
