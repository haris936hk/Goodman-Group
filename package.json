{
  "name": "goodman",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "packageManager": "npm@11.17.0",
  "overrides": {
    "dompurify": "3.4.17",
    "happy-dom": "21.0.4",
    "graphql-scalars": "2.0.1"
  },
  "scripts": {
    "dev": "next dev",
    "payload": "payload",
    "cms:admin:create": "payload run scripts/cms-create-admin.ts",
    "cms:admin:reset-password": "payload run scripts/cms-reset-password.ts",
    "package:operations": "node scripts/package-operations.mjs",
    "test:cms": "vitest run --config vitest.cms.config.mts",
    "build": "next build && npm run package:standalone",
    "package:standalone": "cp -a public .next/standalone/ && cp -a .next/static .next/standalone/.next/",
    "smoke:deployment": "node scripts/smoke-deployment.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:all": "playwright test",
    "test:e2e:headed": "playwright test --project=chromium --headed",
    "test:e2e:ui": "playwright test --ui",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@faceless-ui/modal": "3.0.0",
    "@faceless-ui/scroll-info": "2.0.0",
    "@libsql/client": "0.14.0",
    "@payloadcms/db-sqlite": "3.92.1",
    "@payloadcms/next": "3.92.1",
    "@payloadcms/richtext-lexical": "3.92.1",
    "@payloadcms/ui": "3.92.1",
    "graphql": "16.13.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "libphonenumber-js": "^1.13.14",
    "lucide-react": "^1.34.0",
    "next": "16.4.3",
    "payload": "3.92.1",
    "react": "19.2.8",
    "react-aria-components": "^1.21.1",
    "react-dom": "19.2.8",
    "sharp": "0.35.5",
    "tar": "7.5.22"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/jsdom": "30.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jsdom": "^30.0.1",
    "react-doctor": "^0.9.17",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
